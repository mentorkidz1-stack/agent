# Port du serveur webhook local
PORT=3000

# Clé API Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE_NAME=your_instance_name

# Modèle Gemini utilisé (function calling pour l'ajout au catalogue).
# gemini-1.5-flash est retiré de l'API : on utilise le flash actuel,
# le même que le reste du prototype validé.
GEMINI_MODEL=gemini-3.6-flash

# --- Mode admin : ajout de formations/services au site DFM Solution ---

# Numéros WhatsApp autorisés à administrer le catalogue par vocal/texte,
# séparés par des virgules, format international SANS "+" ni espace.
# Exemple : ADMIN_WHATSAPP_NUMBERS=22990000000,22997000000
ADMIN_WHATSAPP_NUMBERS=

# URL de base du CMS DFM Solution (celui qui expose /api/admin/*)
CMS_API_URL=http://localhost:3001

# Token Bearer partagé avec le CMS (même valeur que WHATSAPP_API_TOKEN
# dans le .env du serveur CMS)
CMS_API_TOKEN=your_shared_secret_token

# URL publique du site, utilisée pour construire le lien envoyé en
# confirmation à l'admin (optionnel)
SITE_PUBLIC_URL=https://dfmsolution.com
